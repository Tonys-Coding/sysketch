{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w sysketch && npm run build -w sysketch-hosted && npm run logos -w sysketch-hosted",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api?route=mcp"
    },
    {
      "source": "/health",
      "destination": "/api?route=health"
    },
    {
      "source": "/d/:file",
      "destination": "/api?route=d&file=:file"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api?route=.well-known/openai-apps-challenge"
    },
    {
      "source": "/.well-known/glama.json",
      "destination": "/api?route=.well-known/glama.json"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "logos/**"
    }
  }
}
