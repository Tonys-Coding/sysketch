{
  "name": "sysketch",
  "version": "0.4.1",
  "description": "Polished system design diagrams from a few lines of YAML. Your AI writes a tiny spec; a deterministic renderer draws the SVG/PNG.",
  "keywords": [
    "system-design",
    "architecture",
    "diagram",
    "diagrams-as-code",
    "svg",
    "png",
    "yaml",
    "isometric",
    "icons",
    "llm",
    "ai",
    "mcp",
    "elk"
  ],
  "author": "Tonys-Coding (https://github.com/Tonys-Coding)",
  "license": "MIT",
  "homepage": "https://github.com/Tonys-Coding/sysketch#readme",
  "bugs": {
    "url": "https://github.com/Tonys-Coding/sysketch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tonys-Coding/sysketch.git",
    "directory": "packages/sysketch"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sysketch": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "opentype.js": "^1.3.4",
    "roughjs": "^4.6.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@types/opentype.js": "^1.3.10"
  }
}
