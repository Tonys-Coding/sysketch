{
  "name": "sysketch",
  "version": "0.0.0",
  "description": "Turn a tiny diagram spec into a polished system design diagram. The LLM never writes SVG.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sysketch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tonys-Coding/sysketch.git"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "opentype.js": "^1.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/opentype.js": "^1.3.10"
  }
}
